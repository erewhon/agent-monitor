#!/bin/bash
# Simple placeholder for the right pane
# Exits cleanly on any signal so attach can take over

trap 'exit 0' EXIT INT TERM

clear

# Colors
DIM='\033[2m'
PURPLE='\033[35m'
RESET='\033[0m'

# Get terminal size
cols=$(tput cols)
rows=$(tput lines)
center_row=$((rows / 2))
center_col=$((cols / 2))

# Draw centered message
tput cup $((center_row - 1)) $((center_col - 15))
echo -e "${PURPLE}◇${RESET}${DIM}  Select an agent from the left${RESET}"

tput cup $((center_row + 1)) $((center_col - 10))
echo -e "${DIM}Enter to attach, l to focus${RESET}"

# Just wait (sleep in a way that's interruptible)
while true; do
    sleep 86400 &
    wait $!
done
